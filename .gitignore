*.nro
*.kip
prod.keys
keys.txt
*.keys
RomFS/
romfs/
saves/
*.sav

# Local capture / run artifacts
run/
save/
shots/
tmp/
*.log

# Archive policy: never add game payloads, credentials or local runtime outputs.
*.nso
*.bin
*.spv
*.air
*.metallib
*.pdb
*.ipa
*.xcz
*.nsz
*.pem
*.p12
*.pfx
*.mobileprovision
